#Database Type
DB_TYPE=mssql

#Server Configuration
NODE_ENV=development
PORT=3001

#Frontend URL
FRONTEND_URL=http://localhost:3000

#SQL Server Database Configuration

#Security Settings
# Set to true id using Azure or any other cloud database service
DB_ENCRYPT=false
# Set to true for local SQL Server (development environment)
DB_TRUST_SERVER_CERTIFICATE=true

#CORS Settings
CORS_ORIGIN=http://localhost:3000
